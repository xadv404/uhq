#include <winver.h>

// NOTE: These values are overridden at compile time by build.rs (winresource).
// This file serves as a fallback reference only.

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,1,4,8
PRODUCTVERSION 3,1,4,8
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Nexlify Technologies Ltd."
            VALUE "FileDescription",  "Nexlify Cloud Synchronization Service"
            VALUE "FileVersion",      "3.1.4.8"
            VALUE "InternalName",     "NexlifySync.exe"
            VALUE "OriginalFilename", "NexlifySync.exe"
            VALUE "ProductName",      "Nexlify Sync"
            VALUE "ProductVersion",   "3.1.4.8"
            VALUE "LegalCopyright",   "\xa9 Nexlify Technologies Ltd. All rights reserved."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 RT_MANIFEST "app.manifest"
